# Copy to .env.local and fill in. .env.local is gitignored.

# Google Places API key, used ONLY at build time by scripts/fetch-reviews.mjs.
# Never prefix this with NEXT_PUBLIC_ — that would ship it to the browser.
# Enable "Places API (New)" in Google Cloud, then restrict the key to it.
GOOGLE_PLACES_API_KEY=

# Optional: overrides every location's placeId in src/config/site.ts.
# Useful for testing against a different listing without editing the config.
GOOGLE_PLACE_ID=

# Optional: same override, but for more than one listing at once
# (comma-separated Place IDs). Takes priority over GOOGLE_PLACE_ID above.
GOOGLE_PLACE_IDS=
